# ===================== Modelo (Gemini) =====================
# Opção A, API key do AI Studio (simples; na camada gratuita os dados podem ser usados pelo Google):
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=
# Opção B, Vertex AI com service account (use GOOGLE_CREDENTIALS_JSON com o conteúdo do JSON):
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=seu-projeto
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CREDENTIALS_JSON=
MODEL_FAST=gemini-3.1-flash-lite    # o mais barato (US$ 0,25 / 1,50 por 1M tokens); o 2.5-flash-lite sai de linha em 16/10/2026
MODEL_SMART=gemini-3.1-flash-lite   # report; troque por um modelo maior se a qualidade pedir

# ===================== Banco =====================
# Produção: Postgres (Aiven). Vazio = SQLite local em backend/data/.
DATABASE_URL=

# ===================== Acesso =====================
DEV_MODE=true                  # em produção: false (login por e-mail e senha)
# Só em produção (DEV_MODE=false):
SECRET_KEY=                    # 32+ caracteres aleatórios: python -c "import secrets; print(secrets.token_urlsafe(48))"
BOOTSTRAP_MANAGER_EMAIL=       # cria o primeiro time e gestor se o banco estiver vazio; o link de primeiro acesso vai para o log
BOOTSTRAP_MANAGER_NAME=Gestor
BOOTSTRAP_TEAM_NAME=Meu time
# PUBLIC_BASE_URL=https://seu-app.up.railway.app   # opcional: base dos links de convite (padrão: o endereço da requisição)
